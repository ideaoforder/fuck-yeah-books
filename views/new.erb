<h1>Add a book</h1>

<div class="card" id="finder">
  <h2>Search</h2>
  <p class="muted">Title, author, or both. Searches Open Library<%= " and Google Books" unless ENV["GOOGLE_BOOKS_API_KEY"].to_s.empty? %>. Good for older books without a barcode. Pick a result to add it as a book you own. Pasting an ISBN works too.</p>
  <input id="q" type="search" placeholder="e.g. delillo underworld" autocomplete="off" autofocus>
  <div class="row opts">
    <label>Add as
      <select id="add-status">
        <% Shelf::Book::STATUSES.each do |k, v| %><option value="<%= k %>"><%= v %></option><% end %>
      </select>
    </label>
    <span id="find-status" class="muted"></span>
  </div>
  <ul id="results" class="results"></ul>
</div>

<form class="card" method="post" action="/books/isbn">
  <h2>By ISBN</h2>
  <p class="muted">Type it or scan it. For a stack of books, use <a href="/scan">Scan</a>.</p>
  <div class="row">
    <input name="isbn" placeholder="ISBN-10 or ISBN-13" inputmode="numeric">
    <select name="status">
      <% Shelf::Book::STATUSES.each do |k, v| %><option value="<%= k %>"><%= v %></option><% end %>
    </select>
    <button>Look up &amp; add</button>
  </div>
</form>

<details class="card"<%= " open" if @book.errors.any? %>>
  <summary><h2 class="inline-h">Manually</h2> <span class="muted">for things no database has</span></summary>
  <form method="post" action="/books">
    <%= erb :form, layout: false %>
    <label class="check"><input type="checkbox" name="lookup" value="1" checked> Fill blanks from Open Library if there's an ISBN</label>
    <button>Save</button>
  </form>
</details>

<script src="/add.js"></script>
