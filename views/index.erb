<form class="toolbar" method="get" action="/">
  <div class="tabs">
    <a href="<%= h index_url(status: nil) %>" class="<%= 'on' unless @status %>">All <small><%= @counts['all'] %></small></a>
    <% Shelf::Book::STATUSES.each do |key, label| %>
      <a href="<%= h index_url(status: key) %>" class="<%= 'on' if @status == key %>"><%= label %> <small><%= @counts[key].to_i %></small></a>
    <% end %>
    <span class="seg" role="group" aria-label="Owned filter">
      <a href="<%= h index_url(owned: nil) %>" class="<%= 'on' unless @owned %>">Any</a>
      <a href="<%= h index_url(owned: '1') %>" class="<%= 'on' if @owned == '1' %>">Owned</a>
      <a href="<%= h index_url(owned: '0') %>" class="<%= 'on' if @owned == '0' %>">Not owned</a>
    </span>
  </div>
  <input type="hidden" name="status" value="<%= h @status %>">
  <input type="hidden" name="owned" value="<%= h @owned %>">
  <input type="search" name="q" value="<%= h params['q'] %>" placeholder="Search title, author, tag, ISBN">
  <select name="sort" onchange="this.form.submit()">
    <% { "added" => "Recently added", "read" => "Recently read", "title" => "Title", "author" => "Author", "rating" => "My rating" }.each do |k, v| %>
      <option value="<%= k %>" <%= 'selected' if @sort == k %>><%= v %></option>
    <% end %>
  </select>
</form>

<% if @books.empty? %>
  <% if @status || @owned || params["q"].to_s.strip != "" %>
  <p class="empty">Nothing matches. <a href="/">Clear filters</a></p>
  <% else %>
  <p class="empty">No books yet. <a href="/scan">Scan some</a>, <a href="/books/new">add one</a>, or <a href="/import">import your Goodreads / StoryGraph library</a>.</p>
  <% end %>
<% else %>
  <%# Checkboxes live in the table but belong to this form (form="bulk"), so
      the per-row forms (✓ Read) don't end up nested. %>
  <form id="bulk" class="bulkbar" method="post" action="/books/bulk" hidden>
    <strong><span id="bulk-count">0</span> selected</strong>
    <select name="bulk_action" id="bulk-action">
      <% Shelf::Bulk::ACTIONS.each do |k, v| %><option value="<%= k %>"><%= v %></option><% end %>
    </select>
    <select name="value" id="bulk-status" data-for="status">
      <% Shelf::Book::STATUSES.each do |k, v| %><option value="<%= k %>"><%= v %></option><% end %>
    </select>
    <input name="value" id="bulk-tag" data-for="add_tag remove_tag" list="all-tags" placeholder="tag" disabled hidden>
    <datalist id="all-tags"><% @all_tags.each do |t| %><option value="<%= h t %>"><% end %></datalist>
    <button>Apply</button>
    <button type="button" class="ghost" id="bulk-clear">Clear</button>
  </form>

  <table class="books selectable">
    <tr class="head">
      <th class="sel"><input type="checkbox" id="select-all" title="Select all <%= @books.size %>"></th>
      <th colspan="6" class="muted"><%= @books.size %> <%= @books.size == 1 ? "book" : "books" %></th>
    </tr>
    <% @books.each do |b| %>
      <tr>
        <td class="sel"><input type="checkbox" name="ids[]" value="<%= b.id %>" form="bulk" aria-label="Select <%= h b.display_title %>"></td>
        <td class="c"><a href="/books/<%= b.id %>"><%= cover(b, "M", "thumb") %></a></td>
        <td>
          <a class="title" href="/books/<%= b.id %>"><%= h b.display_title %></a>
          <div class="muted"><%= h b.author_list.join(", ") %></div>
        </td>
        <td class="muted"><%= h b.format %></td>
        <td><%= status_pill(b) %> <%= finish_button(b) %>
          <% if (l = b.current_borrow) %><span class="pill lent">lent to <%= h l.borrowed_by %></span><% end %>
        </td>
        <td class="num rate"><%= star_input(b) %></td>
        <td class="muted num"><%= b[:last_read] ? fmt_date(Date.parse(b[:last_read].to_s)) : "" %></td>
      </tr>
    <% end %>
  </table>
<% end %>
